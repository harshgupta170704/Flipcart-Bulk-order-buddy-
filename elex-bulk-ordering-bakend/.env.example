# Copy to .env and adjust. All vars are prefixed with ORDERING_.

# Database — SQLite for local/dev, PostgreSQL for production (see PLAN.md §3)
ORDERING_DATABASE_URL=sqlite:///./ordering.db
# ORDERING_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ordering
# A host's own address works as given, e.g. Neon's DIRECT one (not "-pooler"):
# ORDERING_DATABASE_URL=postgresql://user:pass@ep-....ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Moving this machine's data into an empty PostgreSQL first: put its address
# here, then run `python -m app.cli copy-to-postgres` (docs/DEPLOY.md §6).
# ORDERING_NEW_DATABASE_URL=

# Automation timeouts (seconds) — merged from the three old data.json files.
ORDERING_LOGIN_WAIT=10
ORDERING_OTP_WAIT=10
ORDERING_FK_WINDOW_WAIT=10
ORDERING_REFRESH_TIME=2
ORDERING_COUPON_WINDOW_WAIT=10
ORDERING_COUPON_WAIT=3
ORDERING_PAYMETHOD_WAIT=50
ORDERING_CARD_SELECT_WAIT=3
ORDERING_BANK_OTP_FILL_WAIT=300
ORDERING_ORDERLIST_WAIT=300
ORDERING_CONTENT_WAIT=5

# Browser (Playwright)
ORDERING_BROWSER_HEADLESS=true
ORDERING_PROXY_SERVER=
# Account windows per browser: a run opens one Chromium and gives each account
# its own isolated window inside it; past this many it opens another Chromium.
ORDERING_CONTEXTS_PER_BROWSER=8

# OTP inbox (IMAP) — leave host/user blank to disable automatic OTP reading.
ORDERING_OTP_IMAP_HOST=
ORDERING_OTP_IMAP_PORT=993
ORDERING_OTP_IMAP_USER=
# A Gmail app password (16 letters), never the account password. Real values
# belong in .env only — this file is committed.
ORDERING_OTP_IMAP_PASSWORD=
ORDERING_OTP_IMAP_MAILBOX=INBOX
ORDERING_OTP_IMAP_USE_SSL=true
ORDERING_OTP_POLL_INTERVAL=3
ORDERING_OTP_FETCH_TIMEOUT=60
# CorpAssist (HDFC) child-card emails are read from the inbox above: only mail
# from these senders (comma-separated), this many days back.
ORDERING_HDFC_SENDER_FILTER=hdfc
ORDERING_HDFC_SINCE_DAYS=30
# Debug only: print the OTP itself in the log to prove the inbox is being read.
# Turn back off once setup is confirmed.
ORDERING_OTP_LOG_CODES=false
# A second inbox, for accounts whose login codes land in another mailbox (and
# _3, _4 … for more): _USER_2 and _PASSWORD_2 are required. A Gmail address
# needs no _HOST_2 (it is read from imap.gmail.com); any other borrows the
# host above, this file's, never one saved on the Settings page. _PORT_2,
# _MAILBOX_2 and _USE_SSL_2 fall back to the inbox above when its host is the
# one used, else to 993, INBOX and SSL. _FOR_2 lists the account emails it
# serves (commas; "@domain" for every account of a domain), the inbox's own
# address when left out. An account listed there gets its code from that
# inbox; every other account from the one above. The Settings page shows these
# inboxes, and any it cannot use with the reason, but edits only the first.
#ORDERING_OTP_IMAP_USER_2=
#ORDERING_OTP_IMAP_PASSWORD_2=
#ORDERING_OTP_IMAP_FOR_2=

# Concurrency — how many accounts a job processes in parallel.
# Raise gradually: too high triggers Flipkart's rate-limiting and ends up slower.
ORDERING_MAX_CONCURRENCY=4

# Where invoice PDFs are kept (fetched during read-back, or uploaded). A
# directory on a persistent disk; in Docker the appdata volume at /app/data.
ORDERING_INVOICE_DIR=./data/invoices

# Orders placed by this tool are read back from Flipkart on their own until
# they arrive: every ORDERING_TRACK_EVERY_MINUTES while on their way, every
# ORDERING_OUT_FOR_DELIVERY_MINUTES once Flipkart says out for delivery (the
# delivery code shows only from then). Only the accounts holding such orders
# are read. 0 switches either off.
ORDERING_TRACK_EVERY_MINUTES=60
ORDERING_OUT_FOR_DELIVERY_MINUTES=30

# Job queue. Blank = everything runs in-process and NO Redis is required.
# Set it to fan login/coupon jobs out to arq workers. Ordering jobs always run
# in-process so card details are never serialized into a queue (PLAN.md §5).
ORDERING_REDIS_URL=

# --- App authentication (the app is internet-facing: see docs/DEPLOY.md §4) ---
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# The app will not start on the shipped value below unless ORDERING_DEV_MODE
# is true (a laptop): anywhere else, put a generated secret here.
ORDERING_JWT_SECRET=dev-only-insecure-secret-change-me-in-production
ORDERING_JWT_ALGORITHM=HS256
# 8 hours: the working day (spec C-13).
ORDERING_ACCESS_TOKEN_EXPIRE_MINUTES=480
ORDERING_ADMIN_USERNAME=admin
# Preferred. Generate: python -m app.core.security hash '<your password>'
# Paste the whole value in single quotes: it contains '$' signs that a shell
# or docker compose would otherwise read as variables, and a hash with a part
# missing locks the admin out (start-up reports one as an ERROR).
ORDERING_ADMIN_PASSWORD_HASH=
# Dev-only plaintext fallback, used only when the hash above is blank.
ORDERING_ADMIN_PASSWORD=admin
# These are the bootstrap admin's credentials. The username is the admin's
# sign-in name — an email, or any name such as the default "admin" (an admin
# user row is created for it at start-up) — and this password always signs in
# as that admin beside whatever password they set in the app: the way back in
# when every password is lost. Add other users, as admins or operators, under
# Users in the app. No usable password here? Set one from the server with
# `python -m app.cli set-password <email>`.
# The shipped default password "admin" is refused at sign-in unless this is
# true. Keep it false anywhere but a laptop.
ORDERING_DEV_MODE=false

# Sign-in throttling: wrong passwords (or reset-link asks) tolerated inside
# fifteen minutes before that door is locked for fifteen minutes — for one
# email, and for one calling address. The address limit is much higher so an
# office behind one address is not locked out by one person's typos. The
# address is the browser's only when the proxy in front forwards it (see
# FORWARDED_ALLOW_IPS in backend/Dockerfile).
ORDERING_LOGIN_MAX_FAILURES_PER_EMAIL=5
ORDERING_LOGIN_MAX_FAILURES_PER_ADDRESS=50

# Level of the app's own log lines: DEBUG, INFO, WARNING or ERROR. The audit
# trail (who changed what) is written at INFO whatever this says.
ORDERING_LOG_LEVEL=INFO

# Password hashing work factor (PBKDF2-SHA256 iterations) for user passwords.
ORDERING_PBKDF2_ITERATIONS=390000

# --- Mail: the "Forgot password?" reset link (spec C-13) ---------------------
# Blank host => no mail is sent and the sign-in page offers no reset link; an
# admin sets a temporary password under Users instead. The link points at
# ORDERING_APP_URL, the address people open the app at.
ORDERING_SMTP_HOST=
ORDERING_SMTP_PORT=587
ORDERING_SMTP_USER=
ORDERING_SMTP_PASSWORD=
ORDERING_SMTP_FROM=
ORDERING_SMTP_STARTTLS=true
ORDERING_APP_URL=
ORDERING_PASSWORD_RESET_MINUTES=60

# The interactive API docs (/docs, /openapi.json) describe every route of an
# internet-facing app: off unless this says true.
ORDERING_EXPOSE_DOCS=false

# CORS. Normally irrelevant: the browser reaches the API through a proxy on its
# own origin (Vite in dev, nginx in prod). Only needed for direct cross-origin calls.
ORDERING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compiled invoice archives (zips) — beside the invoice PDFs above, under /app
# in Docker (the appdata volume); S3 later. Archives are deleted after the
# retention; 0 keeps them for ever.
ORDERING_ARCHIVE_DIR=./data/archives
ORDERING_ARCHIVE_RETENTION_DAYS=90

# Business details (GSTIN, name, delivery address, pin) are not settings: they
# live in the Address Book (the Addresses & GSTs page), and every ordering run
# ships to an address chosen there. There is no config fallback. Values that an
# older deployment set under ORDERING_DEFAULT_* are carried into the Address
# Book once at start-up when it is still empty.
